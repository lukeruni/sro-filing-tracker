# Runtime data. Never committed: a clone starts empty and populates on first
# refresh. Committing scraped data makes the repo a stale mirror of the SEC.
#
# These are anchored with a leading slash on purpose. A bare "exports/" matches
# at ANY depth and silently excluded src/sro_tracker/exports/ - the package -
# producing a clone that installed cleanly and then failed on import. Tests did
# not catch it because pytest reads from src/ directly; only a real clone did.
/data/
/exports/
/logs/

# Local configuration may carry contact addresses, internal proxies, CA bundle
# paths and mail recipients.
config.toml
.env
*.pem
*.crt

# Generated output
*.xlsx
*.csv
!tests/fixtures/*.csv

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
